# Read-only. Copy to .env locally; never commit a real key.
# NEWAPI_API_KEY=
# EVOK_NEWAPI_LIVE=
# NEWAPI_DEFAULT_MODEL=  # optional allowlisted override (DeepSeek*/Gemini*); empty falls back to deepseek-v4-flash-ga-260731
# EVOK_LLM_LIVE_TEST=  # opt-in live newapi tests (1|true). Default bun test excludes *.live.test.ts. Also requires NEWAPI_API_KEY.
